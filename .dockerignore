# Version control
.git
.gitignore

# Dependencies (rebuilt in container)
node_modules

# Build output (rebuilt in container)
.next

# Editor / IDE
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker
Dockerfile
docker-compose.yml
