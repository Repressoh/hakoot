NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Resend ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Auth ────────────────────────────────────────────────────────────────────
INVITE_HMAC_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
JWT_PRIVATE_KEY=

# ─── Convex – Development deployment ─────────────────────────────────────────
# Managed automatically by `npx convex dev` (written to .env.local).
# For Docker, obtain from: Convex dashboard → Settings → Deploy keys → Dev key
CONVEX_DEPLOYMENT=dev:your-dev-deployment-slug
NEXT_PUBLIC_CONVEX_URL=https://your-dev-deployment-slug.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-dev-deployment-slug.convex.site

# ─── Convex – Production deployment ──────────────────────────────────────────
# Obtain from: Convex dashboard → Settings → Deploy keys → Prod key
# Deploy key used by: docker compose run --rm deploy-convex-prod
CONVEX_DEPLOY_KEY=
